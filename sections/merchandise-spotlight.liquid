<div class="merchandise-spotlight color-{{ section.settings.color_scheme }}">
  {% if section.settings.background_image %}
    <div class="merchandise-spotlight__background">
      <img
        src="{{ section.settings.background_image | image_url: width: 1600 }}"
        alt="{{ section.settings.background_image.alt | escape }}"
        loading="lazy"
        width="1600"
        height="{{ 1600 | divided_by: section.settings.background_image.aspect_ratio }}"
      >
    </div>
  {% endif %}

  <div class="merchandise-spotlight__content">
    {% if section.settings.heading != blank %}
      <h2 class="merchandise-spotlight__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="merchandise-spotlight__blocks">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>
{% stylesheet %}
  .growth-history {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm, 12px);
    padding-block: var(--padding-sm, 12px);
    padding-left: var(--padding-md, 16px);
    border-left: 3px solid var(--color-border, currentColor);
  }

  .growth-history__text {
    font-size: var(--font-heading--size-small, 1.5rem);
    font-style: italic;
    font-weight: var(--font-weight-medium, 500);
    line-height: var(--font-heading--line-height, 1.3);
    margin: 0;
    border: none;
    padding: 0;
  }

  .growth-history__attribution {
    font-style: normal;
    font-size: var(--font-paragraph-small--size);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .growth-history__profile {
    margin-top: var(--margin-sm, 8px);
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xs, 4px);
  }

  .growth-history__farm-history {
    font-weight: var(--font-weight-semibold);
    margin: 0;
  }

  .growth-history__harvest-notes {
    font-size: var(--font-paragraph-small--size);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .growth-strength {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xs, 4px);
  }

  .growth-strength__label {
    font-size: var(--font-paragraph-small--size);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .growth-strength__value {
    font-size: var(--font-heading--size-small, 1.5rem);
    font-weight: var(--font-weight-bold);
  }

  .merchandise-spotlight {
    background: var(--color-background);
    color: var(--color-foreground);
    position: relative;
    overflow: hidden;
  }

  .merchandise-spotlight__background {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .merchandise-spotlight__background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .merchandise-spotlight__content {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg, 24px);
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
    padding-block: var(--padding-xl, 48px);
  }

  .merchandise-spotlight__heading {
    font-size: var(--font-heading--size, 2.5rem);
    font-weight: var(--font-weight-bold, 700);
    line-height: var(--font-heading--line-height, 1.1);
    margin: 0 0 var(--margin-sm, 12px) 0;
  }

  .merchandise-spotlight__blocks {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg, 24px);
    max-width: 640px;
    font-size: var(--font-paragraph--size);
    line-height: var(--font-paragraph--line-height);
  }

  .merchandise-spotlight__blocks p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .merchandise-spotlight__heading {
      font-size: var(--font-heading--size-mobile, 2rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.origin_spotlight",
  "tag": "section",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.origin_spotlight_heading",
      "default": "Our Origins"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.origin_spotlight_background_image"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.origin_spotlight_product",
      "info": "t:settings.origin_spotlight_product_info"
    }
  ],
  "presets": [
    {
      "name": "t:names.origin_spotlight",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
