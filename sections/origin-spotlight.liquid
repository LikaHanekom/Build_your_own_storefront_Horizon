<div class="origin-spotlight color-{{ section.settings.color_scheme }}">
  {% if section.settings.background_image %}
    <div class="origin-spotlight__background">
      <img
        src="{{ section.settings.background_image | image_url: width: 1600 }}"
        alt="{{ section.settings.background_image.alt | escape }}"
        loading="lazy"
        width="1600"
        height="{{ 1600 | divided_by: section.settings.background_image.aspect_ratio }}"
      >
    </div>
  {% endif %}

  <div class="origin-spotlight__content page-width">
    {% if section.settings.heading != blank %}
      <h2 class="origin-spotlight__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="origin-spotlight__blocks">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:names.origin_spotlight",
  "tag": "section",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.origin_spotlight_heading",
      "default": "Our Origins"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.origin_spotlight_background_image"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.origin_spotlight_product",
      "info": "t:settings.origin_spotlight_product_info"
    }
  ],
  "presets": [
    {
      "name": "t:names.origin_spotlight",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
