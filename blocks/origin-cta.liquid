<div class="origin-cta" {{ block.shopify_attributes }}>
  {% if block.settings.cta_label != blank and block.settings.cta_link != blank %}
    href="{{ block.settings.cta_link }}" class="origin-cta__button origin-cta__button--{{ block.settings.cta_style }}" >
    {{ block.settings.cta_label }}
    </a>
  {% endif %}

  {% if block.settings.show_subtext and block.settings.subtext != blank %}
    <p class="origin-cta__subtext">{{ block.settings.subtext }}</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "t:names.origin_cta",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:settings.origin_cta_label",
      "default": "Shop this origin"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:settings.origin_cta_link"
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "t:settings.origin_cta_style",
      "options": [
        { "value": "solid", "label": "t:options.solid" },
        { "value": "outline", "label": "t:options.outline" }
      ],
      "default": "solid"
    },
    {
      "type": "checkbox",
      "id": "show_subtext",
      "label": "t:settings.origin_cta_show_subtext",
      "default": false
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "t:settings.origin_cta_subtext",
      "visible_if": "{{ block.settings.show_subtext }}"
    }
  ],
  "presets": [{ "name": "t:names.origin_cta" }]
}
{% endschema %}
